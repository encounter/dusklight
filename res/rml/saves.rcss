window.saves content pane.save-list {
    flex: 0 0 320dp;
}

window.saves content pane.save-detail {
    gap: 10dp;
}

window.saves .save-title {
    display: block;
    font-size: 30dp;
    font-weight: bold;
    line-height: 1.2;
}

window.saves .save-subtitle {
    display: block;
    margin-top: -8dp;
    color: rgba(224, 219, 200, 55%);
    font-size: 15dp;
}

window.saves .save-overview {
    display: block;
    padding: 14dp 16dp;
    border-radius: 12dp;
    background-color: rgba(17, 16, 10, 30%);
    box-shadow: rgba(146, 135, 91, 30%) 0 0 0 1dp;
}

window.saves .save-overview.present {
    box-shadow: rgba(68, 204, 85, 40%) 0 0 0 1dp;
}

window.saves .save-overview-title {
    display: block;
    font-weight: bold;
    line-height: 1.3;
}

window.saves .save-overview.present .save-overview-title {
    color: #66cc77;
}

window.saves .save-overview-meta,
window.saves .save-help,
window.saves .save-path {
    display: block;
    color: rgba(224, 219, 200, 62%);
    font-size: 15dp;
    line-height: 1.4;
}

window.saves .save-overview-meta {
    margin-top: 2dp;
}

window.saves .save-path {
    word-break: break-all;
}

window.saves button {
    text-align: left;
}

window.saves button.danger {
    color: #ee7777;
    box-shadow: rgba(179, 38, 30, 55%) 0 0 0 1dp;
}

@media (max-width: 720dp) {
    window.saves content pane.save-list {
        flex: 0 0 42%;
    }
}

@media (max-height: 640dp) {
    window.saves content pane.save-list {
        flex: 1 1 0;
    }
}
